-start;gap:14px;padding:10px 0;border-bottom:1px dashed rgba(140,116,100,.22);font-size:15px}\n.feat:last-child{border-bottom:none}\n.plan-card.featured .feat{border-bottom-color:rgba(244,239,230,.18)}\n.feat::before{content:\"\";flex:0 0 auto;width:20px;height:20px;border-radius:50%;background:var(--mint-soft);position:relative;margin-top:4px}\n.plan-card.featured .feat::before{background:var(--mint)}\n.feat::after{content:\"\";position:absolute;width:8px;height:8px;border-left:2px solid var(--mint-deep);border-bottom:2px solid var(--mint-deep);transform:rotate(-45deg);margin-top:9px;margin-left:6px}\n.plan-card.featured .feat::after{border-color:var(--brown-deep)}\n\n/* ---------- 使用说明 ---------- */\n.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;counter-reset:step}\n.step{background:#fff;border-radius:26px;padding:38px 32px;box-shadow:var(--shadow);border:1px solid rgba(140,116,100,.12);position:relative;counter-increment:step}\n.step::before{content:counter(step,decimal-leading-zero);position:absolute;top:24px;right:28px;font-size:48px;font-weight:900;color:var(--mint-soft);line-height:1;letter-spacing:-.04em}\n.step h3{font-size:20px;margin-bottom:12px;color:var(--ink);position:relative;z-index:1}\n.step p{font-size:15px;color:var(--brown-soft);position:relative;z-index:1}\n.step .hint{display:inline-block;margin-top:18px;font-size:12px;letter-spacing:.18em;color:var(--mint-deep);font-weight:700}\n\n/* ---------- 客户端 ---------- */\n.clients{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}\n.client-card{background:#fff;border-radius:24px;padding:30px 32px;box-shadow:var(--shadow);border:1px solid rgba(140,116,100,.12);display:flex;align-items:center;gap:22px}\n.client-ico{width:64px;height:64px;border-radius:18px;background:var(--mint-soft);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;color:var(--brown-mid);letter-spacing:.04em;flex:0 0 auto}\n.client-info h4{font-size:18px;color:var(--ink);margin-bottom:6px}\n.client-info p{font-size:13px;color:var(--brown-soft)}\n.client-info a{display:inline-block;margin-top:12px;font-size:13px;color:var(--mint-deep);font-weight:700;border-bottom:1px dashed currentColor;padding-bottom:1px}\n\n.client-note{text-align:center;margin-top:48px;color:var(--brown-soft);font-size:14px}\n\n/* ---------- FAQ：details 折叠 ---------- */\n.faq-wrap{max-width:880px;margin:0 auto}\n.faq-item{background:#fff;border-radius:20px;margin-bottom:14px;box-shadow:var(--shadow);border:1px solid rgba(140,116,100,.12);overflow:hidden}\n.faq-item summary{cursor:pointer;list-style:none;padding:24px 30px;font-size:17px;font-weight:600;color:var(--ink);display:flex;justify-content:space-between;align-items:center;gap:18px}\n.faq-item summary::-webkit-details-marker{display:none}\n.faq-item summary::after{content:\"+\";font-size:26px;color:var(--mint-deep);font-weight:400;transition:.3s;flex:0 0 auto}\n.faq-item[open] summary::after{transform:rotate(45deg)}\n.faq-answer{padding:0 30px 26px;font-size:15px;color:var(--brown-soft);border-top:1px dashed rgba(140,116,100,.22);padding-top:18px}\n\n/* ---------- 页脚 ---------- */\nfooter{background:#1A130E;color:rgba(244,239,230,.55);padding:60px 0 40px;text-align:center;font-size:13px;letter-spacing:.1em}\nfooter .b{display:block;color:var(--paper);font-weight:700;letter-spacing:.3em;margin-bottom:12px;font-size:14px}\n\n@media(max-width:960px){\n  .hero-inner{grid-template-columns:1fr;gap:60px;padding:90px 0 60px}\n  .hero-right{margin-left:0;padding-bottom:0}\n  .hero-note{margin-left:0;max-width:100%}\n  .hero::before{font-size:60vw;right:-5vw}\n  .split{grid-template-columns:1fr;gap:48px}\n  .plan-card{grid-template-columns:1fr;padding:34px 28px;gap:28px}\n  .plan-side .price{font-size:52px}\n  .steps{grid-template-columns:1fr}\n  .clients{grid-template-columns:1fr}\n  section{padding:80px 0}\n}\n@media(max-width:520px){\n  .wrap{padding:0 18px}\n  .hero h1{font-size:54px}\n  .anchor-tabs a{font-size:13px;padding:9px 14px}\n  .hero-note{padding:24px}\n  .plan-side .price{font-size:44px}\n}\n</style><main>\n\n\n<section class=\"hero\" id=\"top\">\n<div class=\"wrap hero-inner\">\n\n  <div class=\"hero-left\">\n    <span class=\"brand-mark\"><span></span>27SSR · 节点订阅</span>\n    <h1>27SSR · 把网络线路，<em>收拾成一个干净的清单。</em></h1>\n    <p class=\"hero-lead\">27SSR 专注做一件事：把订阅、流量和节点参数整理成一份简单直接的方案，让你在工作、出差、搬家的路上，不用重复设置。</p>\n    <nav class=\"anchor-tabs\" aria-label=\"首屏跳转\">\n      <a href=\"#about\">服务说明</a>\n      <a href=\"#plans\">套餐价格</a>\n      <a href=\"#usage\">使用步骤</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n\n  <div class=\"hero-right\">\n    <div class=\"hero-note\">\n      <h3>本次更新说明</h3>\n      <div class=\"row\"><b>订阅方式</b><span>链接 + 一键导入</span></div>\n      <div class=\"row\"><b>套餐档位</b><span>三档可切换</span></div>\n      <div class=\"row\"><b>支持设备</b><span>按档位递增</span></div>\n      <div class=\"row\"><b>账单周期</b><span>月付 / 年付</span></div>\n    </div>\n  </div>\n\n</div>\n</section>\n\n\n<section class=\"paper\" id=\"about\">\n<div class=\"wrap\">\n<div class=\"sec-head\">\n  <span class=\"tag\">SERVICE NOTE</span>\n  <h2>服务说明，写给人看</h2>\n  <p>不是口号，是把每件事怎么走，写得明明白白。</p>\n</div>\n\n<div class=\"split\">\n  <div class=\"copy\">\n    <p><strong>27SSR</strong> 围绕订阅、流量和节点三类内容，把日常会用到的功能收拢在一处。账号开通后，你会拿到一条订阅链接，把它导入客户端即可同步节点。</p>\n    <p>我们会按月整理可用节点和线路说明，把同一地区、同一运营商的入口放在一起，方便后续替换和备选。</p>\n    <p>流量按月清零，跨月不结转；套餐可随时升降级，未使用完的余额按页面提示结算。</p>\n  </div>\n\n  <div class=\"kv-list\">\n    <div class=\"kv\">\n      <div class=\"num\">01 / 订阅</div>\n      <h3>一条链接搞定多端</h3>\n      <p>同一个订阅链接，在桌面端、移动端、路由器上各导入一次就能同步节点信息。</p>\n    </div>\n    <div class=\"kv\">\n      <div class=\"num\">02 / 流量</div>\n      <h3>按档位划清边界</h3>\n      <p>流量分基础、旗舰、团队三档，所有档位在首页和客户端里都看得见剩余额度。</p>\n    </div>\n    <div class=\"kv\">\n      <div class=\"num\">03 / 节点</div>\n      <h3>只放可用线路</h3>\n      <p>节点状态有变动时，我们会更新到订阅里，无需你手动改配置。</p>\n    </div>\n  </div>\n</div>\n</div>\n</section>\n\n\n<section id=\"plans\">\n<div class=\"wrap\">\n<div class=\"sec-head\">\n  <span class=\"tag\">PLANS</span>\n  <h2>三档套餐，按使用习惯选</h2>\n  <p>月付可随时停，年付更省事。</p>\n</div>\n\n<div class=\"plans-stack\">\n\n  <div class=\"plan-card\">\n    <div class=\"plan-side\">\n      <div class=\"name\">基础版</div>\n      <div class=\"price\">¥15<small>/月</small></div>\n      <span class=\"annual\">按年付仅需 ¥150/年</span>\n    </div>\n    <ul class=\"plan-feats\">\n      <li class=\"feat\">每月 100GB 极速流量</li>\n      <li class=\"feat\">支持 3 台设备同时在线</li>\n      <li class=\"feat\">解锁基础流媒体</li>\n      <li class=\"feat\">普通线路节点池</li>\n    </ul>\n  </div>\n\n  <div class=\"plan-card featured\">\n    <div class=\"plan-side\">\n      <div class=\"name\">旗舰版</div>\n      <div class=\"price\">¥35<small>/月</small></div>\n      <span class=\"annual\">按年付仅需 ¥350/年</span>\n    </div>\n    <ul class=\"plan-feats\">\n      <li class=\"feat\">每月 300GB 极速流量</li>\n      <li class=\"feat\">支持 5 台设备同时在线</li>\n      <li class=\"feat\">全节点原生流媒体解锁</li>\n      <li class=\"feat\">IPLC 专线游戏加速优化</li>\n      <li class=\"feat\">7x24 优先工单支持</li>\n    </ul>\n  </div>\n\n  <div class=\"plan-card\">\n    <div class=\"plan-side\">\n      <div class=\"name\">团队版</div>\n      <div class=\"price\">¥85<small>/月</small></div>\n      <span class=\"annual\">按年付仅需 ¥850/年</span>\n    </div>\n    <ul class=\"plan-feats\">\n      <li class=\"feat\">每月 1000GB 极速流量</li>\n      <li class=\"feat\">支持 20 台设备同时在线</li>\n      <li class=\"feat\">VIP 专属高带宽节点</li>\n      <li class=\"feat\">支持企业定制路由</li>\n      <li class=\"feat\">专属客户经理服务</li>\n    </ul>\n  </div>\n\n</div>\n</div>\n</section>\n\n\n<section class=\"paper\" id=\"usage\">\n<div class=\"wrap\">\n<div class=\"sec-head\">\n  <span class=\"tag\">HOW TO USE</span>\n  <h2>三步，从开通到连上</h2>\n  <p>流程固定，不绕弯。</p>\n</div>\n\n<div class=\"steps\">\n  <div class=\"step\">\n    <h3>选择套餐</h3>\n    <p>在套餐区域选好档位，填写注册邮箱，确认月付或年付方式后提交订单。</p>\n    <span class=\"hint\">STEP 01</span>\n  </div>\n  <div class=\"step\">\n    <h3>拿到订阅链接</h3>\n    <p>开通完成后，在用户中心的订阅栏目复制你专属的链接或二维码。</p>\n    <span class=\"hint\">STEP 02</span>\n  </div>\n  <div class=\"step\">\n    <h3>导入并连接</h3>\n    <p>把链接粘进常用客户端的订阅地址栏，软件会自动同步节点并测速。</p>\n    <span class=\"hint\">STEP 03</span>\n  </div>\n</div>\n</div>\n</section>\n\n\n<section class=\"dark\" id=\"clients\">\n<div class=\"wrap\">\n<div class=\"sec-head\">\n  <span class=\"tag\">CLIENTS</span>\n  <h2>常用客户端，一键导入</h2>\n  <p>覆盖桌面和移动端最常见的几款软件，按个人习惯选即可。</p>\n</div>\n\n<div class=\"clients\">\n  <article class=\"client-card\">\n    <div class=\"client-ico\">SS</div>\n    <div class=\"client-info\">\n      <h4>Shadowrocket 类客户端</h4>\n      <p>适合 iOS / iPadOS 设备使用，通过订阅链接即可同步节点信息。</p>\n      <a href=\"#\">前往 App Store</a>\n    </div>\n  </article>\n\n  <article class=\"client-card\">\n    <div class=\"client-ico\">CF</div>\n    <div class=\"client-info\">\n      <h4>Clash 系列客户端</h4>\n      <p>桌面端常用方案，支持规则分流与节点分组，社区维护活跃。</p>\n      <a href=\"#\">查看桌面版</a>\n    </div>\n  </article>\n\n  <article class=\"client-card\">\n    <div class=\"client-ico\">QV</div>\n    <div class=\"client-info\">\n      <h4>Quantumult / X 类工具</h4>\n      <p>另一类常用的网络工具客户端，适合需要更细颗粒度控制的场景。</p>\n      <a href=\"#\">查看支持列表</a>\n    </div>\n  </article>\n\n  <article class=\"client-card\">\n    <div class=\"client-ico\">RT</div>\n    <div class=\"client-info\">\n      <h4>路由器 OpenWrt 方案</h4>\n      <p>把订阅导入路由器即可全家设备共享节点，适合长连接场景。</p>\n      <a href=\"#\">查看插件说明</a>\n    </div>\n  </article>\n</div>\n\n<p class=\"client-note\">不同客户端对协议和分组的写法有差异，具体步骤以本页面内的“使用步骤”栏目为准。</p>\n</div>\n</section>\n\n\n<section class=\"mint\" id=\"faq\">\n<div class=\"wrap\">\n<div class=\"sec-head\">\n  <span class=\"tag\">FAQ</span>\n  <h2>常见问题，逐条说明</h2>\n  <p>挑了被问得最多的几条，展开看答案。</p>\n</div>\n\n<div class=\"faq-wrap\">\n\n  <details class=\"faq-item\">\n    <summary>订阅链接在哪里看？</summary>\n    <div class=\"faq-answer\">订阅链接在用户中心的「我的订阅」栏目里可以查看和复制，同时也会以二维码形式展示，方便移动端直接扫码导入。</div>\n  </details>\n\n  <details class=\"faq-item\">\n    <summary>套餐可以中途升级或降级吗？</summary>\n    <div class=\"faq-answer\">可以。在用户中心选择目标档位并确认生效时间即可，未使用完的余额会按页面提示折算到新套餐里。</div>\n  </details>\n\n  <details class=\"faq-item\">\n    <summary>流量是怎么计算的？</summary>\n    <div class=\"faq-answer\">流量按自然月统计，每月 1 日 0 点重置。不同时区的设备上行与下行都会计入，按套餐对应档位扣除对应额度。</div>\n  </details>\n\n  <details class=\"faq-item\">\n    <summary>支持多少台设备同时在线？</summary>\n    <div class=\"faq-answer\">基础版 3 台、旗舰版 5 台、团队版 20 台。超过限制会无法新增连接，已连上的设备不会立即断开。</div>\n  </details>\n\n  <details class=\"faq-item\">\n    <summary>节点不可用时怎么办？</summary>\n    <div class=\"faq-answer\">先尝试在客户端里点一次「更新订阅」，让节点列表重新拉取。如果仍然无法连接，把地区与报错信息提交到工单即可。</div>\n  </details>\n\n  <details class=\"faq-item\">\n    <summary>年付套餐有没有优惠？</summary>\n    <div class=\"faq-answer\">年付相当于一次性付 10 个月的费用，三档套餐都可以在「按年付仅需」标注里看到折后价格。</div>\n  </details>\n\n</div>\n</div>\n</section>\n\n</main>\n\n<footer>\n  <span class=\"b\">27SSR</span>\n  © 2026 27SSR · 节点订阅与流量服务 · 一切以页面说明为准\n</footer>",
